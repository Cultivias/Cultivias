---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { getEntry } from 'astro:content';

const s = (await getEntry('settings', 'site'))!.data;

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  ogType?: string;
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    section?: string;
    tags?: string[];
  };
  jsonLd?: object | object[];
  noindex?: boolean;
  preloadImage?: string;
}

const {
  title,
  description = 'Cultivias.com – vaš izvor informacija o voću, povrću i ljekovitom bilju. Stručni članci, savjeti za uzgoj i zdravlje.',
  image = '/images/og-default.jpg',
  canonical,
  ogType = 'website',
  article,
  jsonLd,
  noindex = false,
  preloadImage,
} = Astro.props;

const siteUrl = 'https://www.cultivias.com';
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : `${siteUrl}${Astro.url.pathname}`;
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;

const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: s.siteName,
  url: siteUrl,
  description,
};

const jsonLdData = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [defaultJsonLd];
---

<!DOCTYPE html>
<html lang="hr">
<head>
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-KSPFCXPB');</script>
  
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="Cultivias" />
  <meta property="og:locale" content="hr_HR" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Hreflang & Favicon -->
  <link rel="alternate" hreflang="hr" href={canonicalUrl} />
  <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
  <link rel="icon" type="image/png" sizes="48x48" href="/images/favicon.png" />
  <link rel="apple-touch-icon" href="/images/favicon.png" />

  {article && (
    <>
      {article.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
      {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
      {article.author && <meta property="article:author" content={article.author} />}
      {article.section && <meta property="article:section" content={article.section} />}
      {article.tags?.map(tag => <meta property="article:tag" content={tag} />)}
    </>
  )}

  <!-- Google preferred source link (za botove) -->
  <link rel="publisher" href="https://www.google.com/preferences/source?q=cultivias.com" />

  {jsonLdData.map(schema => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}

  <style is:inline set:html={`
    :root{
      --color-primary:${s.colorPrimary};
      --color-primary-dark:${s.colorPrimaryDark};
      --color-accent:${s.colorAccent};
      --color-accent-dark:${s.colorAccentDark};
      --color-dark:${s.colorDark};
      --color-bg-mint:${s.colorBgMint};
      --color-bg-pale:${s.colorBgPale};
      --color-text:#222222;
    }
    html,body{background-color:${s.colorBgMint};font-family:'Inter',system-ui,sans-serif;color:#222222}
  `}></style>

  <!-- Font loading: Optimized -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,400;0,700;0,900;1,400&family=Inter:wght@400;500;600;700&display=swap" />
  
  {preloadImage && <link rel="preload" as="image" href={preloadImage} />}
</head>
<body>
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KSPFCXPB"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  
  <div class="bg-dark text-white text-center py-2.5 text-xs sm:text-sm font-medium font-body tracking-wide">
    {s.tagline}
  </div>
  <Header />
  <main>
    <slot />

    {article && (
      <div class="max-w-2xl mx-auto my-10 px-4">
        <a
          href="https://www.google.com/preferences/source?q=cultivias.com"
          target="_blank"
          rel="noopener noreferrer"
          class="flex items-center justify-center gap-3 rounded-2xl px-6 py-4 bg-white shadow-sm no-underline transition-all duration-200 hover:shadow-md"
          style="border: 1px solid color-mix(in srgb, var(--color-primary) 25%, transparent); color: var(--color-text);"
        >
          <svg class="w-6 h-6 flex-shrink-0" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.31-1.03 2.41-2.12 3.14v2.6h3.43c2.01-1.85 3.33-4.57 3.33-7.75z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.43-2.6c-.98.66-2.23 1.05-3.85 1.05-2.96 0-5.47-2-6.37-4.69H2.07v2.69C3.89 20.44 7.63 23 12 23z" fill="#34A853"/>
            <path d="M5.63 16.1A6.36 6.36 0 0 1 5 12c0-.72.13-1.42.36-2.1v-2.7H2.07A10.96 10.96 0 0 0 1 12c0 1.77.43 3.45 1.18 4.96l3.45-2.86z" fill="#FBBC05"/>
            <path d="M12 4.9c1.62 0 3.07.56 4.22 1.66l3.16-3.16C17.45 1.58 14.97.5 12 .5 7.63.5 3.89 3.06 2.07 6.9l3.56 2.7c.9-2.69 3.41-4.7 6.37-4.7z" fill="#EA4335"/>
          </svg>
          <span class="font-medium text-sm sm:text-base">
            Dodaj <strong style="color: var(--color-primary);">Cultivias.com</strong> među omiljene izvore na Googleu
          </span>
        </a>
      </div>
    )}
  </main>
  <Footer />
  <CookieBanner />
</body>
</html>
