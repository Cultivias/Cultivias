---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { getEntry } from 'astro:content';

const s = (await getEntry('settings', 'site'))!.data;

interface Props {
  title: string;
  description?: string;
  image?: string;
  canonical?: string;
  ogType?: string;
  article?: {
    publishedTime?: string;
    modifiedTime?: string;
    author?: string;
    section?: string;
    tags?: string[];
  };
  jsonLd?: object | object[];
  noindex?: boolean;
  preloadImage?: string;
}

const {
  title,
  description = 'Cultivias.com – vaš izvor informacija o voću, povrću i ljekovitom bilju. Stručni članci, savjeti za uzgoj i zdravlje.',
  image = '/images/og-default.jpg',
  canonical,
  ogType = 'website',
  article,
  jsonLd,
  noindex = false,
  preloadImage,
} = Astro.props;

const siteUrl = 'https://www.cultivias.com';
const canonicalUrl = canonical ? `${siteUrl}${canonical}` : `${siteUrl}${Astro.url.pathname}`;
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;

const defaultJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: s.siteName,
  url: siteUrl,
  description,
};

const jsonLdData = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [defaultJsonLd];
---

<!DOCTYPE html>
<html lang="hr">
<head>
  <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
  new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
  j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
  'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
  })(window,document,'script','dataLayer','GTM-KSPFCXPB');</script>
  
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />

  <title>{title}</title>
  <meta name="description" content={description} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <link rel="canonical" href={canonicalUrl} />

  <!-- Open Graph -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:site_name" content="Cultivias" />
  <meta property="og:locale" content="hr_HR" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />

  <!-- Hreflang & Favicon -->
  <link rel="alternate" hreflang="hr" href={canonicalUrl} />
  <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
  <link rel="icon" type="image/png" sizes="48x48" href="/images/favicon.png" />
  <link rel="apple-touch-icon" href="/images/favicon.png" />

  {article && (
    <>
      {article.publishedTime && <meta property="article:published_time" content={article.publishedTime} />}
      {article.modifiedTime && <meta property="article:modified_time" content={article.modifiedTime} />}
      {article.author && <meta property="article:author" content={article.author} />}
      {article.section && <meta property="article:section" content={article.section} />}
      {article.tags?.map(tag => <meta property="article:tag" content={tag} />)}
      
      <link rel="publisher" href="https://www.google.com/preferences/source?q=cultivias.com" />
    </>
  )}

  {jsonLdData.map(schema => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))}

  <style is:inline set:html={`
    :root{
      --color-primary:${s.colorPrimary};
      --color-primary-dark:${s.colorPrimaryDark};
      --color-accent:${s.colorAccent};
      --color-accent-dark:${s.colorAccentDark};
      --color-dark:${s.colorDark};
      --color-bg-mint:${s.colorBgMint};
      --color-bg-pale:${s.colorBgPale};
      --color-text:#222222;
    }
    html,body{background-color:${s.colorBgMint};font-family:'Inter',system-ui,sans-serif;color:#222222}
  `}></style>

  <!-- Font loading: Optimized -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,400;0,700;0,900;1,400&family=Inter:wght@400;500;600;700&display=swap" />
  
  {preloadImage && <link rel="preload" as="image" href={preloadImage} />}
</head>
<body>
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-KSPFCXPB"
  height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  
  <div class="bg-dark text-white text-center py-2.5 text-xs sm:text-sm font-medium font-body tracking-wide">
    {s.tagline}
  </div>
  <Header />
  <main>
    <slot />
  </main>
  <Footer />
  <CookieBanner />
</body>
</html>
