---
import { getEntry, getCollection } from 'astro:content';

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const s = (await getEntry('settings', 'site'))!.data;

const cmsPages = (await getCollection('pages'))
  .filter(p => p.data.showInNav)
  .map(p => ({ href: `${base}${p.slug}/`, label: p.data.title }));

const navLinks = [
  ...s.navLinks.map(l => ({ href: `${base}${l.href}`, label: l.label })),
  ...cmsPages,
];
const pathname = Astro.url.pathname;
---

<header class="sticky top-0 z-50 bg-white shadow-sm border-b border-bg-pale">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">

      <a href={base} class="flex items-center gap-3 flex-shrink-0 group" aria-label="Cultivias - Naslovnica">
        <img 
          src="/logo.webp" 
          alt="Cultivias - Life & Food" 
          class="h-16 w-16 object-contain transition-transform duration-300 group-hover:scale-105"
          onerror="this.onerror=null; this.src='/logo.png';" 
        />
      </a>

      <nav class="hidden md:flex items-center gap-1" aria-label="Glavna navigacija">
        {navLinks.map(link => (
          <a
            href={link.href}
            class={`px-4 py-2 rounded-lg text-sm font-semibold transition-colors duration-150 font-body ${
              pathname.includes(link.href.replace(base, '/'))
                ? 'text-primary bg-bg-pale'
                : 'text-dark hover:text-primary hover:bg-bg-mint'
            }`}
          >
            {link.label}
          </a>
        ))}
      </nav>

      <div class="hidden md:flex items-center gap-3">
        <button id="search-btn" aria-label="Pretraži" class="p-2 rounded-lg text-dark hover:text-primary hover:bg-bg-mint transition-colors">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-4.35-4.35M16.5 10.5a6 6 0 11-12 0 6 6 0 0112 0z"/></svg>
        </button>
        <a href={`${base}#newsletter`} class="btn-accent text-sm px-4 py-2 rounded-lg">Newsletter</a>
      </div>

      <button id="mobile-menu-btn" aria-label="Otvori izbornik" class="md:hidden p-2 rounded-lg text-dark hover:text-primary hover:bg-bg-mint transition-colors">
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>
  </div>
  
  <div id="search-overlay" class="hidden fixed inset-0 z-50 bg-dark/80 flex items-start justify-center pt-24" role="dialog">
    </div>
</header>

<div id="mobile-menu" class="hidden fixed inset-0 z-40 bg-dark flex flex-col" role="dialog">
  <div class="flex items-center justify-between px-4 py-4 border-b border-white/10">
    <a href={base} class="flex items-center gap-2" onclick="document.getElementById('mobile-menu').classList.add('hidden')">
      <img src="/logo.webp" alt="Cultivias Logo" class="h-16 w-16 object-contain" />
    </a>
    <button id="mobile-menu-close" class="p-2 text-white hover:text-primary"><svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg></button>
  </div>
  </div>
