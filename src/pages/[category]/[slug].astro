---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getCollection, getEntry } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.map(article => ({
    params: {
      category: article.data.category,
      slug: article.slug, // Astro auto-generates slug from filename
    },
    props: { article },
  }));
}

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const { article } = Astro.props;
const articleSlug = article.slug; // e.g. "zdravstvene-prednosti-borovnice"

// Render content and extract headings for TOC and FAQ
const { Content, headings } = await article.render();
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);

// Load author
const authorEntry = await getEntry('authors', article.data.author);
const author = authorEntry?.data;

// Load related articles
const allArticles = await getCollection('articles');
let relatedArticles: (typeof allArticles)[number][] = [];

if (article.data.related_articles?.length > 0) {
  relatedArticles = allArticles
    .filter(a => article.data.related_articles.includes(a.slug) && a.slug !== articleSlug)
    .slice(0, 3);
}

// Fallback: same category, excluding already added
if (relatedArticles.length < 3) {
  const existingSlugs = new Set(relatedArticles.map(a => a.slug));
  const additional = allArticles
    .filter(a => a.data.category === article.data.category && a.slug !== articleSlug && !existingSlugs.has(a.slug))
    .slice(0, 3 - relatedArticles.length);
  relatedArticles = [...relatedArticles, ...additional];
}

const categoryLabels: Record<string, string> = {
  voce: 'Voće',
  povrce: 'Povrće',
  bilje: 'Bilje',
  vijesti: 'Vijesti',
};

const categoryLabel = categoryLabels[article.data.category];

function formatDate(dateStr: string) {
  return new Date(dateStr).toLocaleDateString('hr-HR', {
    day: 'numeric', month: 'long', year: 'numeric',
  });
}

const showExpertBadge = article.data.expert_reviewed && author?.role === 'expert';

// ==========================================
// 1. JSON-LD: BlogPosting (Glavni Article Schema)
// ==========================================
const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting', // Bolje od 'Article' za tematski portal
  headline: article.data.title,
  description: article.data.metaDescription || article.data.perex,
  image: [
    `https://cultivias.com${article.data.image}` // Idealno bi bilo dodati 1x1, 4x3 i 16x9 verzije ako ih imate u Frontmatteru
  ],
  datePublished: new Date(article.data.publishedAt ).toISOString(),
  dateModified: new Date(article.data.updatedAt || article.data.publishedAt).toISOString(),
  author: {
    '@type': 'Person',
    name: author?.name || article.data.author,
    url: `https://cultivias.com/autor/${article.data.author}/`,
  },
  publisher: {
    '@type': 'Organization',
    name: 'Cultivias',
    url: 'https://cultivias.com',
    logo: { 
      '@type': 'ImageObject', 
      url: 'https://cultivias.com/logo.svg',
      width: 600,
      height: 60
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': `https://cultivias.com/${article.data.category}/${articleSlug}/`,
  },
  url: `https://cultivias.com/${article.data.category}/${articleSlug}/`,
  inLanguage: 'hr',
  keywords: article.data.tags?.join(', ' ) || '',
  articleSection: categoryLabel,
  wordCount: article.body?.split(/\s+/).length || 0, // Gruba procjena riječi ako je body dostupan
  timeRequired: `PT${article.data.readTime || 5}M`, // Format vremena čitanja
};

// ==========================================
// 2. JSON-LD: BreadcrumbList
// ==========================================
const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Naslovnica', item: 'https://cultivias.com/' },
    { '@type': 'ListItem', position: 2, name: categoryLabel, item: `https://cultivias.com/${article.data.category}/` },
    { '@type': 'ListItem', position: 3, name: article.data.title, item: `https://cultivias.com/${article.data.category}/${articleSlug}/` },
  ],
};

// ==========================================
// 3. JSON-LD: FAQPage (Automatsko generiranje iz Frontmattera ili naslova )
// ==========================================
let faqJsonLd = null;

// Ako u Frontmatteru (MD/MDX) postoji polje `faq` (niz objekata { question, answer })
if (article.data.faq && article.data.faq.length > 0) {
  faqJsonLd = {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: article.data.faq.map(faqItem => ({
      '@type': 'Question',
      name: faqItem.question,
      acceptedAnswer: {
        '@type': 'Answer',
        text: faqItem.answer
      }
    } ))
  };
}

// Spajamo sve validne JSON-LD objekte u jedan niz koji prosljeđujemo u BaseLayout
const allJsonLd = [articleJsonLd, breadcrumbJsonLd];
if (faqJsonLd) {
  allJsonLd.push(faqJsonLd);
}

// Sidebar: recent articles in same category
const sidebarArticles = allArticles
  .filter(a => a.data.category === article.data.category && a.slug !== articleSlug)
  .sort((a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime())
  .slice(0, 4);

const allCategories = ['voce', 'povrce', 'bilje', 'vijesti'];
---

<BaseLayout
  title={article.data.metaTitle || `${article.data.title} | Cultivias`}
  description={article.data.metaDescription || article.data.perex}
  image={article.data.ogImage || article.data.image}
  preloadImage={article.data.image}
  canonical={article.data.canonicalUrl || `/${article.data.category}/${articleSlug}/`}
  noindex={article.data.noindex}
  ogType="article"
  article={{
    publishedTime: article.data.publishedAt,
    modifiedTime: article.data.updatedAt,
    author: author?.name,
    section: categoryLabel,
    tags: article.data.tags,
  }}
  jsonLd={allJsonLd} 
>
