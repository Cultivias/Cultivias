---
// CMS admin — nije indeksirano, nije linkano s ostalim stranicama
---
<!DOCTYPE html>
<html lang="hr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="robots" content="noindex, nofollow" />
  <title>Cultivias CMS</title>

  <style>
    /* ── Brand boje ── */
    :root {
      --primary: #5cab88;
      --primary-dark: #3d8a67;
      --dark: #06140C;
      --bg: #EDF6EE;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }

    body {
      font-family: 'Inter', system-ui, sans-serif;
      background: var(--bg);
    }

    /* Loading screen dok se CMS inicijalizira */
    #cms-loading {
      position: fixed; inset: 0;
      background: var(--dark);
      display: flex; flex-direction: column;
      align-items: center; justify-content: center;
      gap: 16px; z-index: 9999;
      transition: opacity 0.4s;
    }
    #cms-loading svg { animation: spin 1.2s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    #cms-loading p { color: rgba(255,255,255,0.5); font-size: 13px; letter-spacing: 0.05em; }

    /* Decap CMS header → brand zelena */
    [class*="AppHeader"],
    [class*="app-header"],
    header[class*="Header"] {
      background-color: var(--dark) !important;
    }

    /* Sidebar */
    [class*="Nav"],
    [class*="sidebar"],
    [class*="Sidebar"] {
      background-color: #0d2016 !important;
    }

    /* Akcijski gumbi */
    [class*="PrimaryButton"],
    button[class*="primary"],
    [class*="ToolbarButton"] {
      background-color: var(--primary) !important;
      border-color: var(--primary-dark) !important;
    }
    [class*="PrimaryButton"]:hover,
    button[class*="primary"]:hover {
      background-color: var(--primary-dark) !important;
    }

    /* Fokus boja inputa */
    input:focus, textarea:focus, select:focus {
      outline-color: var(--primary) !important;
      border-color: var(--primary) !important;
    }

    /* ── Mobilni prikaz ── */
    @media (max-width: 768px) {
      /* Sidebar jako uzan na mobu — proširi ga */
      [class*="AppHeader"] { padding: 0 12px !important; }

      /* Nav sidebar scrollable */
      [class*="Nav"], [class*="Sidebar"] {
        width: 100% !important;
        max-width: 100% !important;
        overflow-y: auto !important;
      }

      /* Veći touch targeti za gumbe */
      button, [role="button"] {
        min-height: 40px;
        min-width: 40px;
      }

      /* Toolbar gumbi u editoru */
      [class*="Toolbar"] button {
        padding: 8px !important;
      }

      /* Publish gumb uvijek vidljiv */
      [class*="PublishControl"],
      [class*="ToolbarContainer"] {
        position: sticky !important;
        bottom: 0 !important;
        z-index: 100 !important;
        background: white !important;
        padding: 8px 12px !important;
        border-top: 1px solid #e5e7eb !important;
      }

      /* Preview panel sakrij na mobu (premalen) */
      [class*="PreviewPane"],
      [class*="preview-pane"] {
        display: none !important;
      }

      /* Editor full width */
      [class*="EditorContainer"],
      [class*="editor-container"] {
        width: 100% !important;
        max-width: 100% !important;
      }

      /* Input polja veća */
      [class*="ControlContainer"] input,
      [class*="ControlContainer"] textarea,
      [class*="ControlContainer"] select {
        font-size: 16px !important; /* sprječava zoom na iOS */
      }
    }
  </style>
</head>
<body>

  <!-- Loading screen -->
  <div id="cms-loading">
    <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="#5cab88" stroke-width="2">
      <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/>
    </svg>
    <p>CULTIVIAS CMS — učitavanje...</p>
  </div>

  <script is:inline>window.CMS_MANUAL_INIT = true;</script>
  <script is:inline src="https://unpkg.com/decap-cms@^3.0.0/dist/decap-cms.js"></script>

  <script is:inline>
    // Sakrij loading screen čim CMS mountira
    document.addEventListener('DOMContentLoaded', () => {
      const observer = new MutationObserver(() => {
        const root = document.getElementById('nc-root');
        if (root && root.children.length > 0) {
          const el = document.getElementById('cms-loading');
          if (el) { el.style.opacity = '0'; setTimeout(() => el.remove(), 400); }
          observer.disconnect();
        }
      });
      observer.observe(document.body, { childList: true, subtree: true });
    });

    CMS.init({
      config: {
        backend: {
          name: 'github',
          repo: 'Cultivias2026/Cultivias-Cultivias',
          branch: 'main',
          base_url: 'https://cms-auth.cultivias-info.workers.dev',
        },
        media_folder: 'public/images/articles',
        public_folder: '/images/articles',
        locale: 'hr',
        collections: [
          {
            name: 'articles',
            label: 'Članci',
            label_singular: 'Članak',
            folder: 'src/content/articles',
            create: true,
            delete: true,
            slug: '{{slug}}',
            extension: 'md',
            format: 'frontmatter',
            summary: '{{title}} — {{category}}',
            sortable_fields: ['publishedAt', 'title', 'category'],
            view_filters: [
              { label: 'Voće',               field: 'category',    pattern: 'voce' },
              { label: 'Povrće',             field: 'category',    pattern: 'povrce' },
              { label: 'Bilje',              field: 'category',    pattern: 'bilje' },
              { label: 'Vijesti',            field: 'category',    pattern: 'vijesti' },
              { label: 'Istaknuto',          field: 'featured',    pattern: true },
              { label: 'Preporuka urednika', field: 'editors_pick', pattern: true },
            ],
            fields: [
              {
                label: 'Naslov',
                name: 'title',
                widget: 'string',
                hint: 'Naslov koji se prikazuje na kartici i u pregledniku',
              },
              {
                label: 'Kategorija',
                name: 'category',
                widget: 'select',
                options: [
                  { label: 'Voće',    value: 'voce' },
                  { label: 'Povrće',  value: 'povrce' },
                  { label: 'Bilje',   value: 'bilje' },
                  { label: 'Vijesti', value: 'vijesti' },
                ],
              },
              {
                label: 'Autor',
                name: 'author',
                widget: 'select',
                options: [
                  { label: 'Ana Kovač',    value: 'ana-kovac' },
                  { label: 'Petra Horvat', value: 'petra-horvat' },
                  { label: 'Redakcija',    value: 'redakcija' },
                ],
              },
              {
                label: 'Naslovna slika',
                name: 'image',
                widget: 'image',
                hint: 'Upload slike ili unesite Unsplash URL (npr. https://images.unsplash.com/photo-ID?w=800&h=500&fit=crop)',
                choose_url: true,
                media_library: {
                  config: { multiple: false },
                },
              },
              {
                label: 'Perex (uvodni tekst)',
                name: 'perex',
                widget: 'text',
                hint: 'Kratki opis koji se prikazuje na kartici i u meta oznakama. Max 400 znakova.',
              },
              {
                label: 'Čitanje (min)',
                name: 'readTime',
                widget: 'number',
                default: 5,
                min: 1,
                max: 60,
                value_type: 'int',
              },
              {
                label: 'Datum objave',
                name: 'publishedAt',
                widget: 'datetime',
                format: 'YYYY-MM-DD',
                date_format: 'DD.MM.YYYY',
                time_format: false,
              },
              {
                label: 'Datum ažuriranja',
                name: 'updatedAt',
                widget: 'datetime',
                format: 'YYYY-MM-DD',
                date_format: 'DD.MM.YYYY',
                time_format: false,
                required: false,
              },
              { label: 'Stručno provjereno',  name: 'expert_reviewed', widget: 'boolean', default: false },
              { label: 'Istaknuto (hero)',     name: 'featured',        widget: 'boolean', default: false, hint: 'Samo jedan članak treba biti istaknut' },
              { label: 'Preporuka urednika',  name: 'editors_pick',    widget: 'boolean', default: false },
              {
                label: 'Tagovi',
                name: 'tags',
                widget: 'list',
                default: [],
                hint: 'Pritisnite Enter za svaki novi tag',
              },
              {
                label: 'Povezani članci',
                name: 'related_articles',
                widget: 'relation',
                collection: 'articles',
                search_fields: ['title'],
                value_field: '{{slug}}',
                display_fields: ['title'],
                multiple: true,
                required: false,
                hint: 'Pretražite i odaberite članke',
              },
              {
                label: 'Sadržaj članka',
                name: 'body',
                widget: 'markdown',
                buttons: ['bold', 'italic', 'heading-two', 'heading-three', 'bulleted-list', 'numbered-list', 'link', 'quote', 'code'],
              },
              // ── SEO ──────────────────────────────────────────────
              {
                label: '🔍 SEO naslov (meta title)',
                name: 'metaTitle',
                widget: 'string',
                required: false,
                hint: 'Ostavite prazno za automatski: "[Naslov] | Cultivias". Max 60 znakova.',
              },
              {
                label: '🔍 SEO opis (meta description)',
                name: 'metaDescription',
                widget: 'text',
                required: false,
                hint: 'Ostavite prazno — automatski se koristi perex. Max 160 znakova.',
              },
              {
                label: '🔍 OG slika (social share)',
                name: 'ogImage',
                widget: 'image',
                required: false,
                hint: 'Slika za dijeljenje na Facebooku/Twitteru. Ostavite prazno za naslovnu sliku članka.',
                choose_url: true,
              },
              {
                label: '🔍 Canonical URL',
                name: 'canonicalUrl',
                widget: 'string',
                required: false,
                hint: 'Samo ako ovaj sadržaj postoji na drugoj adresi. Inače ostavite prazno.',
              },
              {
                label: '🔍 Sakrij od tražilica (noindex)',
                name: 'noindex',
                widget: 'boolean',
                default: false,
                hint: 'Uključite samo za draft ili duplicate sadržaj.',
              },
            ],
          },
          {
            name: 'authors',
            label: 'Autori',
            label_singular: 'Autor',
            folder: 'src/content/authors',
            create: true,
            delete: false,
            slug: '{{slug}}',
            extension: 'json',
            format: 'json',
            summary: '{{name}} — {{title}}',
            fields: [
              { label: 'Ime i prezime',    name: 'name',      widget: 'string' },
              { label: 'Slug',             name: 'slug',      widget: 'string', hint: 'Bez razmaka i dijakritika, npr. ana-kovac' },
              { label: 'Titula / zvanje',  name: 'title',     widget: 'string', hint: 'npr. Dipl. ing. agronomije' },
              {
                label: 'Uloga', name: 'role', widget: 'select',
                options: [
                  { label: 'Stručnjak', value: 'expert' },
                  { label: 'Urednik',   value: 'editor' },
                ],
                default: 'expert',
              },
              { label: 'Kratka biografija', name: 'bio_short', widget: 'text' },
              { label: 'Puna biografija',   name: 'bio_long',  widget: 'text' },
              {
                label: 'Avatar',
                name: 'avatar',
                widget: 'image',
                hint: 'Slika profila autora',
                media_folder: '/public/images/autori',
                public_folder: '/images/autori',
              },
              { label: 'Stručnost',        name: 'expertise', widget: 'list', required: false },
              {
                label: 'Društvene mreže', name: 'social', widget: 'object', required: false,
                fields: [
                  { label: 'LinkedIn', name: 'linkedin', widget: 'string', required: false },
                  { label: 'Web',      name: 'web',      widget: 'string', required: false },
                  { label: 'E-mail',   name: 'email',    widget: 'string', required: false },
                ],
              },
            ],
          },
          // ── Stranice ────────────────────────────────────────────
          {
            name: 'pages',
            label: 'Stranice',
            label_singular: 'Stranica',
            folder: 'src/content/pages',
            create: true,
            delete: true,
            slug: '{{slug}}',
            extension: 'md',
            format: 'frontmatter',
            summary: '{{title}}',
            fields: [
              {
                label: 'Naslov stranice',
                name: 'title',
                widget: 'string',
              },
              {
                label: 'Prikaži u navigaciji',
                name: 'showInNav',
                widget: 'boolean',
                default: false,
                hint: 'Dodaje ovu stranicu u header navigaciju',
              },
              {
                label: 'Sadržaj',
                name: 'body',
                widget: 'markdown',
                buttons: ['bold', 'italic', 'heading-two', 'heading-three', 'bulleted-list', 'numbered-list', 'link', 'quote', 'code'],
              },
              {
                label: '🔍 SEO opis',
                name: 'description',
                widget: 'text',
                required: false,
                hint: 'Kratki opis za tražilice. Max 160 znakova.',
              },
              {
                label: '🔍 OG slika',
                name: 'ogImage',
                widget: 'image',
                required: false,
                choose_url: true,
              },
              {
                label: '🔍 Sakrij od tražilica',
                name: 'noindex',
                widget: 'boolean',
                default: false,
              },
            ],
          },
          // ── Postavke sajta ──────────────────────────────────────
          {
            name: 'settings',
            label: 'Postavke sajta',
            files: [
              {
                name: 'site',
                label: 'Opće postavke',
                file: 'src/content/settings/site.json',
                fields: [
                  { label: 'Naziv sajta',  name: 'siteName',    widget: 'string' },
                  { label: 'Slogan (traka iznad headera)', name: 'tagline', widget: 'string' },
                  { label: 'Meta opis (SEO)', name: 'description', widget: 'text' },
                  { label: '🎨 Primarna boja',         name: 'colorPrimary',     widget: 'color', default: '#5cab88', enableAlpha: false },
                  { label: '🎨 Primarna tamna',         name: 'colorPrimaryDark', widget: 'color', default: '#3d8a67', enableAlpha: false },
                  { label: '🎨 Akcentna boja (gumbi)',  name: 'colorAccent',      widget: 'color', default: '#C8873A', enableAlpha: false },
                  { label: '🎨 Akcentna tamna',         name: 'colorAccentDark',  widget: 'color', default: '#a86e2a', enableAlpha: false },
                  { label: '🎨 Tamna (pozadina nav)',   name: 'colorDark',        widget: 'color', default: '#06140C', enableAlpha: false },
                  { label: '🎨 Pozadina (svijetla)',    name: 'colorBgMint',      widget: 'color', default: '#EDF6EE', enableAlpha: false },
                  { label: '🎨 Pozadina (bljedunasta)', name: 'colorBgPale',      widget: 'color', default: '#D4F3D7', enableAlpha: false },
                  {
                    label: 'Navigacija',
                    name: 'navLinks',
                    widget: 'list',
                    hint: 'Redoslijed i nazivi stavki u meniju',
                    fields: [
                      { label: 'Naziv', name: 'label', widget: 'string' },
                      { label: 'URL putanja (npr. voce/)', name: 'href', widget: 'string' },
                    ],
                  },
                  {
                    label: 'Društvene mreže',
                    name: 'social',
                    widget: 'object',
                    fields: [
                      { label: 'Facebook URL',  name: 'facebook',  widget: 'string', required: false },
                      { label: 'Instagram URL', name: 'instagram', widget: 'string', required: false },
                      { label: 'YouTube URL',   name: 'youtube',   widget: 'string', required: false },
                    ],
                  },
                  { label: 'Copyright tekst (footer)', name: 'footerCopyright', widget: 'string' },
                  { label: 'Footer tagline',           name: 'footerTagline',   widget: 'string' },
                  { label: 'Newsletter naslov',        name: 'newsletterHeading', widget: 'string' },
                  { label: 'Newsletter podnaslov',     name: 'newsletterSubtext', widget: 'text' },
                  { label: 'Newsletter napomena',      name: 'newsletterNote',    widget: 'string' },
                ],
              },
            ],
          },
        ],
      },
    });

    // ── Preview stilovi ──────────────────────────────────────────
    CMS.registerPreviewStyle(
      'https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,400;0,700;0,900;1,400&family=Inter:wght@400;500;600;700&display=swap'
    );
    CMS.registerPreviewStyle(`
      :root { --primary:#5cab88; --primary-dark:#3d8a67; --dark:#06140C; --mint:#EDF6EE; --pale:#D4F3D7; }
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      body { font-family: 'Inter', system-ui, sans-serif; background: var(--mint); color: #222; }
      h1,h2,h3,h4,h5,h6 { font-family: 'Merriweather', Georgia, serif; color: var(--dark); }
      article { max-width: 700px; margin: 0 auto; padding: 2rem 1.5rem 4rem; }
      .hero { width:100%; aspect-ratio:16/9; object-fit:cover; border-radius:12px; margin-bottom:1.5rem; display:block; }
      .badge { display:inline-block; font-size:11px; font-weight:700; text-transform:uppercase; letter-spacing:.1em; padding:4px 12px; border-radius:999px; background:var(--pale); color:var(--primary-dark); margin-bottom:.75rem; font-family:'Inter',sans-serif; }
      .title { font-size:2rem; line-height:1.25; margin:.5rem 0 .75rem; }
      .meta { display:flex; gap:1rem; font-size:.8rem; color:#999; padding-bottom:1rem; margin-bottom:1.5rem; border-bottom:2px solid var(--pale); }
      .perex { font-size:1.05rem; font-style:italic; border-left:4px solid var(--primary); padding-left:1rem; color:#444; margin-bottom:2rem; font-family:'Merriweather',Georgia,serif; line-height:1.7; }
      .body h2 { font-size:1.4rem; margin:2rem 0 .6rem; }
      .body h3 { font-size:1.15rem; margin:1.5rem 0 .5rem; }
      .body p  { line-height:1.85; margin-bottom:1rem; font-size:1rem; }
      .body ul,.body ol { padding-left:1.5rem; margin-bottom:1rem; line-height:1.8; }
      .body li { margin-bottom:.25rem; }
      .body a  { color:var(--primary); }
      .body strong { color:var(--dark); }
      .body blockquote { border-left:4px solid var(--primary); padding:.75rem 1rem; background:var(--mint); border-radius:0 8px 8px 0; margin:1.5rem 0; font-style:italic; color:#555; }
      .body img { max-width:100%; border-radius:8px; margin:1rem 0; }
      .body table { width:100%; border-collapse:collapse; margin:1.5rem 0; font-size:.9rem; }
      .body th { background:var(--pale); padding:.5rem .75rem; text-align:left; font-family:'Inter',sans-serif; }
      .body td { padding:.5rem .75rem; border-bottom:1px solid var(--pale); }
      .body code { background:var(--pale); padding:2px 6px; border-radius:4px; font-size:.875em; }
      .body pre  { background:var(--dark); color:#d4f3d7; padding:1rem 1.25rem; border-radius:8px; overflow-x:auto; margin:1.5rem 0; }
    `, { raw: true });

    // ── Preview template za članke ───────────────────────────────
    var catLabels = { voce:'Voće', povrce:'Povrće', bilje:'Bilje', vijesti:'Vijesti' };

    var ArticlePreview = createClass({
      render: function () {
        var entry    = this.props.entry;
        var data     = entry.getIn(['data']);
        var title    = data.getIn(['title'])     || '';
        var category = data.getIn(['category'])  || '';
        var image    = data.getIn(['image'])      || '';
        var perex    = data.getIn(['perex'])      || '';
        var readTime = data.getIn(['readTime'])   || 5;
        var pubRaw   = data.getIn(['publishedAt']);
        var pubDate  = '';
        try { pubDate = new Date(pubRaw).toLocaleDateString('hr-HR', { day:'numeric', month:'long', year:'numeric' }); } catch(e) {}
        var imgSrc = image ? this.props.getAsset(image).toString() : '';

        return h('article', {},
          imgSrc && h('img', { src: imgSrc, className: 'hero', alt: title }),
          h('span', { className: 'badge' }, catLabels[category] || category),
          h('h1',   { className: 'title' }, title),
          h('div',  { className: 'meta' },
            pubDate  && h('span', {}, pubDate),
            h('span', {}, readTime + ' min čitanja')
          ),
          perex && h('p', { className: 'perex' }, perex),
          h('div',  { className: 'body' }, this.props.widgetFor('body'))
        );
      }
    });

    CMS.registerPreviewTemplate('articles', ArticlePreview);
  </script>
</body>
</html>
