---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection, getEntry } from 'astro:content';

const site = (await getEntry('settings', 'site'))!.data;

const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

const allArticles = (await getCollection('articles')).sort(
  (a, b) => new Date(b.data.publishedAt).getTime() - new Date(a.data.publishedAt).getTime()
);

const featuredArticles = allArticles.filter(a => a.data.featured);
const heroArticle = featuredArticles[0] || allArticles[0];

// 2 side cards (not the hero)
const sideCards = allArticles.filter(a => a.id !== heroArticle.id).slice(0, 2);

// Tabs data
const latestArticles = allArticles.slice(0, 5);
const editorsPick = allArticles.filter(a => a.data.editors_pick).slice(0, 5);

// Latest 6 for the article grid section
const recentSix = allArticles.slice(0, 6);

// Right panel: one article per main category (excluding hero)
const rightPanelArticles = (['voce', 'povrce', 'bilje'] as const)
  .map(cat => allArticles.find(a => a.data.category === cat && a.id !== heroArticle.id))
  .filter((a): a is NonNullable<typeof a> => !!a);

// Load hero author
const heroAuthorEntry = await getEntry('authors', heroArticle.data.author);
const heroAuthor = heroAuthorEntry?.data;

// Author cache for all cards
const authorCache: Record<string, any> = {};
for (const article of [...sideCards, ...latestArticles, ...[...allArticles].reverse().slice(0, 5), ...editorsPick, ...recentSix]) {
  if (!authorCache[article.data.author]) {
    const entry = await getEntry('authors', article.data.author);
    if (entry) authorCache[article.data.author] = entry.data;
  }
}

const categoryLabels: Record<string, string> = {
  voce: 'Voće', povrce: 'Povrće', bilje: 'Bilje', vijesti: 'Vijesti',
};

const categoryMeta = [
  { slug: 'voce',    label: 'VOĆE',    bg: '#FDF3E7', text: '#C8873A', border: '#f0d4a8' },
  { slug: 'povrce',  label: 'POVRĆE',  bg: '#F0FBF4', text: '#3d8a67', border: '#D4F3D7' },
  { slug: 'bilje',   label: 'BILJE',   bg: '#EDF6EE', text: '#3d8a67', border: '#b4e5ba' },
  { slug: 'vijesti', label: 'VIJESTI', bg: '#EFF6FF', text: '#2563EB', border: '#bfdbfe' },
];

function formatDate(d: string) {
  return new Date(d).toLocaleDateString('hr-HR', { day: 'numeric', month: 'long', year: 'numeric' });
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Cultivias',
  url: 'https://cultivias.com',
  description: 'Cultivias.com – vaš izvor informacija o voću, povrću i ljekovitom bilju.',
};
---

<BaseLayout
  title="Cultivias – Voće, Povrće i Ljekovito Bilje"
  description="Cultivias.com – vaš pouzdani izvor informacija o voću, povrću i ljekovitom bilju. Stručni članci, savjeti za uzgoj i zdravlje za cijeli Balkan."
  jsonLd={jsonLd}
>

  <!-- ===== HERO ===== -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 pb-6">
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-5">

      <!-- Main hero card (2/3) — full overlay, single <a> wrapper -->
      <div class="lg:col-span-2">
        <article class="relative rounded-2xl overflow-hidden shadow-md sm:h-[360px] lg:h-[100%]">
          <a
            href={`${base}${heroArticle.data.category}/${heroArticle.slug}/`}
            class="absolute inset-0 block group"
            aria-label={heroArticle.data.title}
          >
            <img
              src={heroArticle.data.image}
              alt=""
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="eager"
              onerror="this.onerror=null;this.style.opacity='0'"
            />
            <!-- Gradient overlay -->
            <div
              class="absolute inset-0 pointer-events-none"
              style="background: linear-gradient(to top, rgba(6,20,12,0.93) 0%, rgba(6,20,12,0.55) 38%, rgba(6,20,12,0.08) 72%, transparent 100%);"
            ></div>
          </a>
          <!-- Content overlay at bottom (above the link via z-index) -->
          <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-8 z-10 pointer-events-none">
            <span class="hero-badge-category mb-3 inline-block pointer-events-auto">
              {categoryLabels[heroArticle.data.category]}
            </span>
            <h2 class="text-white text-2xl sm:text-3xl font-bold font-heading leading-tight mb-2">
              {heroArticle.data.title}
            </h2>
            <p class="text-white/65 text-sm leading-relaxed mb-4 line-clamp-2 font-body hidden sm:block">
              {heroArticle.data.perex}
            </p>
            <div class="flex items-center gap-2 text-xs font-body flex-wrap">
              <img
                src={heroAuthor?.avatar || '/images/autori/default.svg'}
                alt={heroAuthor?.name || ''}
                class="w-7 h-7 rounded-full object-cover border border-white/25 flex-shrink-0"
                onerror="this.onerror=null;this.style.opacity='0'"
              />
              <span class="text-white font-semibold">{heroAuthor?.name || heroArticle.data.author}</span>
              <span class="text-white/35">·</span>
              <svg class="w-3.5 h-3.5 text-white/45 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
              </svg>
              <span class="text-white/60">{heroArticle.data.readTime} min čitanja</span>
              <span class="text-white/35">·</span>
              <time datetime={heroArticle.data.publishedAt} class="text-white/60">
                {formatDate(heroArticle.data.publishedAt)}
              </time>
            </div>
          </div>
        </article>
      </div>

      <!-- 2 side cards (1/3) -->
      <div class="flex flex-col gap-4">
        {sideCards.map(article => (
          <article class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-shadow group flex-1 min-h-0 flex flex-col relative">
            <a
              href={`${base}${article.data.category}/${article.slug}/`}
              class="absolute inset-0 z-0"
              aria-label={article.data.title}
            />
            <div class="block overflow-hidden flex-shrink-0 h-[130px] lg:h-[160px] bg-bg-pale">
              <img
                src={article.data.image}
                alt=""
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
                onerror="this.onerror=null;this.style.opacity='0'"
              />
            </div>
            <div class="p-3.5 flex flex-col relative z-10 pointer-events-none">
              <span class="badge-category text-xs mb-1.5 inline-block">{categoryLabels[article.data.category]}</span>
              <h3 class="text-sm font-bold text-dark group-hover:text-primary transition-colors leading-snug line-clamp-2 font-heading">
                {article.data.title}
              </h3>
              <div class="flex items-center gap-1.5 mt-auto pt-2 text-xs text-gray-400 font-body">
                <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
                <span>{article.data.readTime} min · {formatDate(article.data.publishedAt)}</span>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== TABS + CATEGORIES (side by side) ===== -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
    <div class="grid grid-cols-1 lg:grid-cols-5 gap-6">

      <!-- LEFT: Tabs widget (2/5) -->
      <div class="lg:col-span-2 bg-white rounded-2xl shadow-sm p-6">
        <div class="flex items-center border-b border-bg-pale" role="tablist">
          <button class="tab-und-btn active" role="tab" data-tab="najnovije" aria-selected="true">Najnovije</button>
          <button class="tab-und-btn" role="tab" data-tab="najcitanije" aria-selected="false">Najčitanije</button>
          <button class="tab-und-btn" role="tab" data-tab="preporuka" aria-selected="false">Preporuka urednika</button>
        </div>

        <!-- Najnovije panel -->
        <div id="panel-najnovije" role="tabpanel" class="mt-2">
          {latestArticles.map((article, i) => (
            <a
              href={`${base}${article.data.category}/${article.slug}/`}
              class="flex items-center gap-3 py-2.5 hover:bg-bg-mint rounded-lg px-2 -mx-2 transition-colors group"
            >
              <span
                class="text-2xl font-bold w-7 flex-shrink-0 text-center select-none"
                style="color: var(--color-primary); opacity: 0.35; font-family: Georgia, serif;"
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="w-14 h-14 flex-shrink-0 rounded-lg overflow-hidden bg-bg-pale">
                <img
                  src={article.data.image}
                  alt={article.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                  onerror="this.onerror=null;this.style.opacity='0'"
                />
              </div>
              <div class="flex-1 min-w-0">
                <span class="badge-category text-xs mb-0.5 inline-block">{categoryLabels[article.data.category]}</span>
                <h3 class="text-sm font-semibold text-dark group-hover:text-primary transition-colors line-clamp-2 leading-snug font-heading">
                  {article.data.title}
                </h3>
                <span class="text-xs text-gray-400 font-body">{article.data.readTime} min čitanja</span>
              </div>
            </a>
          ))}
        </div>

        <!-- Najčitanije panel -->
        <div id="panel-najcitanije" role="tabpanel" class="hidden mt-2">
          {[...allArticles].reverse().slice(0, 5).map((article, i) => (
            <a
              href={`${base}${article.data.category}/${article.slug}/`}
              class="flex items-center gap-3 py-2.5 hover:bg-bg-mint rounded-lg px-2 -mx-2 transition-colors group"
            >
              <span
                class="text-2xl font-bold w-7 flex-shrink-0 text-center select-none"
                style="color: var(--color-primary); opacity: 0.35; font-family: Georgia, serif;"
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="w-14 h-14 flex-shrink-0 rounded-lg overflow-hidden bg-bg-pale">
                <img
                  src={article.data.image}
                  alt={article.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                  loading="lazy"
                  onerror="this.onerror=null;this.style.opacity='0'"
                />
              </div>
              <div class="flex-1 min-w-0">
                <span class="badge-category text-xs mb-0.5 inline-block">{categoryLabels[article.data.category]}</span>
                <h3 class="text-sm font-semibold text-dark group-hover:text-primary transition-colors line-clamp-2 leading-snug font-heading">
                  {article.data.title}
                </h3>
                <span class="text-xs text-gray-400 font-body">{article.data.readTime} min čitanja</span>
              </div>
            </a>
          ))}
        </div>

        <!-- Preporuka urednika panel -->
        <div id="panel-preporuka" role="tabpanel" class="hidden mt-2">
          {(editorsPick.length > 0 ? editorsPick : latestArticles).slice(0, 5).map((article, i) => (
            <a
              href={`${base}${article.data.category}/${article.slug}/`}
              class="flex items-center gap-3 py-2.5 hover:bg-bg-mint rounded-lg px-2 -mx-2 transition-colors group"
            >
              <span
                class="text-2xl font-bold w-7 flex-shrink-0 text-center select-none"
                style="color: var(--color-primary); opacity: 0.35; font-family: Georgia, serif;"
              >
                {String(i + 1).padStart(2, '0')}
              </span>
              <div class="w-14 h-14 flex-shrink-0 rounded-lg overflow-hidden bg-bg-pale">
                <img
                  src={article.data.image}
                  alt={article.data.title}
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform"
                  loading="lazy"
                  onerror="this.onerror=null;this.style.opacity='0'"
                />
              </div>
              <div class="flex-1 min-w-0">
                <span class="badge-category text-xs mb-0.5 inline-block">{categoryLabels[article.data.category]}</span>
                <h3 class="text-sm font-semibold text-dark group-hover:text-primary transition-colors line-clamp-2 leading-snug font-heading">
                  {article.data.title}
                </h3>
                <span class="text-xs text-gray-400 font-body">{article.data.readTime} min čitanja</span>
              </div>
            </a>
          ))}
        </div>
      </div>

      <!-- RIGHT: Categories + article mini-grid (3/5) -->
      <div class="lg:col-span-3 flex flex-col gap-5">
        <h2 class="text-xl font-bold font-heading text-dark">Istražite po kategorijama</h2>

        <!-- 4 colored category tiles -->
        <div class="grid grid-cols-4 gap-3">
          {categoryMeta.map(cat => {
            const count = allArticles.filter(a => a.data.category === cat.slug).length;
            return (
              <a
                href={`${base}${cat.slug}/`}
                class="rounded-xl p-4 transition-all hover:shadow-md hover:-translate-y-0.5"
                style={`background-color: ${cat.bg}; border: 1px solid ${cat.border};`}
              >
                <div
                  class="text-xs font-bold uppercase tracking-widest mb-2 font-body"
                  style={`color: ${cat.text};`}
                >
                  {cat.label}
                </div>
                <div
                  class="text-4xl font-bold font-heading leading-none"
                  style={`color: ${cat.text};`}
                >
                  {count}
                </div>
                <div
                  class="text-xs mt-1.5 font-body"
                  style={`color: ${cat.text}; opacity: 0.7;`}
                >
                  {count === 1 ? 'članak' : 'članaka'}
                </div>
              </a>
            );
          })}
        </div>

        <!-- Article mini-grid: one per main category -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {rightPanelArticles.map(article => (
            <article class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all group flex relative">
              <a
                href={`${base}${article.data.category}/${article.slug}/`}
                class="absolute inset-0 z-0"
                aria-label={article.data.title}
              />
              <div class="w-24 h-24 flex-shrink-0 bg-bg-pale overflow-hidden">
                <img
                  src={article.data.image}
                  alt=""
                  class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                  loading="lazy"
                  onerror="this.onerror=null;this.style.opacity='0'"
                />
              </div>
              <div class="p-3 flex flex-col justify-center min-w-0 flex-1 relative z-10 pointer-events-none">
                <span class="badge-category text-xs mb-1.5 inline-block">{categoryLabels[article.data.category]}</span>
                <h3 class="text-sm font-bold text-dark group-hover:text-primary transition-colors line-clamp-2 leading-snug font-heading">
                  {article.data.title}
                </h3>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ===== NAJNOVIJI ČLANCI ===== -->
  <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    <div class="flex items-center justify-between mb-6">
      <h2 class="text-2xl font-bold font-heading text-dark">Najnoviji članci</h2>
      <a href={`${base}voce/`} class="text-sm font-semibold transition-colors" style="color: var(--color-primary);">
        Svi članci &rarr;
      </a>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      {recentSix.map(article => {
        const author = authorCache[article.data.author];
        return (
          <article class="bg-white rounded-xl overflow-hidden shadow-sm hover:shadow-md transition-all duration-200 group relative flex flex-col">
            <a
              href={`${base}${article.data.category}/${article.slug}/`}
              class="absolute inset-0 z-0"
              aria-label={article.data.title}
            />
            <div class="overflow-hidden h-48 flex-shrink-0 bg-bg-pale">
              <img
                src={article.data.image}
                alt=""
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
                onerror="this.onerror=null;this.style.opacity='0'"
              />
            </div>
            <div class="p-5 flex flex-col flex-1 relative z-10 pointer-events-none">
              <div class="flex items-center gap-2 flex-wrap mb-3">
                <span class="badge-category">{categoryLabels[article.data.category]}</span>
                {article.data.expert_reviewed && (
                  <span class="badge-expert">
                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                    </svg>
                    Stručno provjereno
                  </span>
                )}
              </div>
              <h3 class="text-base font-bold text-dark group-hover:text-primary transition-colors leading-snug mb-2 font-heading line-clamp-2">
                {article.data.title}
              </h3>
              <p class="text-sm leading-relaxed line-clamp-3 font-body mb-4" style="color: #6b7280;">
                {article.data.perex}
              </p>
              <div class="flex items-center gap-2 mt-auto text-xs font-body" style="color: #9ca3af;">
                <img
                  src={author?.avatar || '/images/autori/default.svg'}
                  alt=""
                  class="w-6 h-6 rounded-full object-cover flex-shrink-0 border border-gray-100"
                  onerror="this.onerror=null;this.style.opacity='0'"
                />
                <span class="font-medium" style="color: #4b5563;">{author?.name || article.data.author}</span>
                <span class="ml-auto flex items-center gap-1">
                  <svg class="w-3.5 h-3.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                  {article.data.readTime} min
                </span>
              </div>
            </div>
          </article>
        );
      })}
    </div>
  </section>

  <!-- ===== NEWSLETTER CTA ===== -->
  <section
    id="newsletter"
    class="my-8 mx-4 sm:mx-6 lg:mx-8 xl:mx-auto xl:max-w-7xl rounded-2xl overflow-hidden"
    style="background-color: var(--color-dark);"
  >
    <div class="px-6 sm:px-16 py-14 flex flex-col lg:flex-row items-center gap-10">

      <!-- Left: tekst -->
      <div class="flex-1 text-center lg:text-left">
        <span class="inline-block text-xs font-bold uppercase tracking-widest mb-4 px-4 py-1.5 rounded-full"
              style="background: rgba(92,171,136,0.15); color: #5cab88; border: 1px solid rgba(92,171,136,0.35);">
          Newsletter
        </span>
        <h2 class="text-2xl sm:text-3xl font-bold text-white font-heading leading-tight mb-3" set:html={site.newsletterHeading.replace('\n', '<br class="hidden sm:block" />')}></h2>
        <p class="text-white/70 text-sm font-body max-w-sm mx-auto lg:mx-0">{site.newsletterSubtext}</p>
        <p class="text-white/40 text-xs mt-3 font-body">{site.newsletterNote}</p>
      </div>

      <!-- Right: forma -->
      <form id="hero-newsletter" class="flex flex-col gap-3 w-full lg:w-auto lg:min-w-[320px]" onsubmit="return false;">
        <input
          type="text"
          placeholder="Vaše ime"
          class="w-full px-5 py-3 rounded-xl text-white text-sm font-body focus:outline-none focus:border-primary transition-colors"
          style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);"
        />
        <input
          type="email"
          placeholder="Vaša e-mail adresa"
          class="w-full px-5 py-3 rounded-xl text-white text-sm font-body focus:outline-none focus:border-primary transition-colors"
          style="background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.15);"
          required
        />
        <button type="submit" class="btn-accent px-6 py-3 rounded-xl font-semibold text-sm w-full">
          Pretplati se →
        </button>
      </form>

    </div>
  </section>

</BaseLayout>

<script>
  // Tabs widget
  const tabBtns = document.querySelectorAll<HTMLButtonElement>('[data-tab]');
  const tabPanels = document.querySelectorAll<HTMLElement>('[role="tabpanel"]');

  tabBtns.forEach(btn => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.tab;
      tabBtns.forEach(b => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      tabPanels.forEach(p => p.classList.add('hidden'));
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      const panel = document.getElementById(`panel-${target}`);
      if (panel) panel.classList.remove('hidden');
    });
  });

  // Newsletter
  document.getElementById('hero-newsletter')?.addEventListener('submit', (e) => {
    e.preventDefault();
    const input = (e.target as HTMLFormElement).querySelector('input[type="email"]') as HTMLInputElement;
    alert(`Hvala! Adresa ${input.value} je uspješno prijavljena.`);
    input.value = '';
  });
</script>
